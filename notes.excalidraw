  "elements": [
    {
      "id": "kUcDdfPq9X-3dfAfHXmTl",
      "type": "text",
      "x": 235.9375888522784,
      "y": 161.24717076922755,
      "width": 1175.2391357421875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1832195871,
      "version": 818,
      "versionNonce": 1203294833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778813190655,
      "link": null,
      "locked": false,
      "text": "Multi-Agent Research Assistant a fully autonomous AI system that thinks, \nsearches, reads and writes on its own. Instead of a single AI answering your question from tools, \nwe are deploying a team of specialized intelligent agents that collaborate together to produce a professional \nresearch report on any topic you give them. The Search Agent goes out on the live internet and finds the \nmost relevant and recent sources. The Reader Agent then dives deep into those sources, scraping and extracting \nmeaningful content. The Writer Agent takes all that gathered intelligence and crafts a well-structured, detailed report. \nAnd finally the Critic Agent reviews the entire report, scores it and gives feedback just like a senior researcher \nreviewing a junior's work. Every single agent is powered by a Large Language Model, connected through LangChain's\n modern LCEL pipeline, and orchestrated through a shared memory system that makes them work as one unified brain. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Multi-Agent Research Assistant a fully autonomous AI system that thinks, \nsearches, reads and writes on its own. Instead of a single AI answering your question from tools, \nwe are deploying a team of specialized intelligent agents that collaborate together to produce a professional \nresearch report on any topic you give them. The Search Agent goes out on the live internet and finds the \nmost relevant and recent sources. The Reader Agent then dives deep into those sources, scraping and extracting \nmeaningful content. The Writer Agent takes all that gathered intelligence and crafts a well-structured, detailed report. \nAnd finally the Critic Agent reviews the entire report, scores it and gives feedback just like a senior researcher \nreviewing a junior's work. Every single agent is powered by a Large Language Model, connected through LangChain's\n modern LCEL pipeline, and orchestrated through a shared memory system that makes them work as one unified brain. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
